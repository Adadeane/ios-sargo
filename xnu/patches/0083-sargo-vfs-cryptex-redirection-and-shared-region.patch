diff --git a/bsd/vfs/vfs_lookup.c b/bsd/vfs/vfs_lookup.c
index 5dd85c7..45f83a6 100644
--- a/bsd/vfs/vfs_lookup.c
+++ b/bsd/vfs/vfs_lookup.c
@@ -278,6 +278,67 @@ retry_copy:
 	ndp->ni_pathlen = (u_int)bytes_copied;
 	bytes_copied = 0;
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * SARGO/SWEET Cryptex VFS Redirection:
+	 * In iOS 16, dyld shared cache and Cryptex assets are located under
+	 * /private/preboot/Cryptexes/OS/ and /private/preboot/Cryptexes/App/.
+	 * Transparently redirect lookups targeting:
+	 * 1) System/Library/Caches/com.apple.dyld -> private/preboot/Cryptexes/OS/System/Library/Caches/com.apple.dyld
+	 * 2) System/Cryptexes/OS -> private/preboot/Cryptexes/OS
+	 * 3) System/Cryptexes/App -> private/preboot/Cryptexes/App
+	 * Preserving any leading slash and updating ndp->ni_pathlen.
+	 */
+	{
+		const char *p = cnp->cn_pnbuf;
+		bool leading_slash = false;
+		if (p[0] == '/') {
+			leading_slash = true;
+			p++;
+		}
+		const char *redir_prefix = NULL;
+		const char *tail = NULL;
+		static const char kDyldCachePrefix[] = "System/Library/Caches/com.apple.dyld";
+		static const size_t kDyldCacheLen = sizeof(kDyldCachePrefix) - 1;
+		static const char kCryptexOSPrefix[] = "System/Cryptexes/OS";
+		static const size_t kCryptexOSLen = sizeof(kCryptexOSPrefix) - 1;
+		static const char kCryptexAppPrefix[] = "System/Cryptexes/App";
+		static const size_t kCryptexAppLen = sizeof(kCryptexAppPrefix) - 1;
+
+		if (strncmp(p, kDyldCachePrefix, kDyldCacheLen) == 0 &&
+		    (p[kDyldCacheLen] == '\0' || p[kDyldCacheLen] == '/')) {
+			redir_prefix = "private/preboot/Cryptexes/OS/System/Library/Caches/com.apple.dyld";
+			tail = p + kDyldCacheLen;
+		} else if (strncmp(p, kCryptexOSPrefix, kCryptexOSLen) == 0 &&
+		    (p[kCryptexOSLen] == '\0' || p[kCryptexOSLen] == '/')) {
+			redir_prefix = "private/preboot/Cryptexes/OS";
+			tail = p + kCryptexOSLen;
+		} else if (strncmp(p, kCryptexAppPrefix, kCryptexAppLen) == 0 &&
+		    (p[kCryptexAppLen] == '\0' || p[kCryptexAppLen] == '/')) {
+			redir_prefix = "private/preboot/Cryptexes/App";
+			tail = p + kCryptexAppLen;
+		}
+
+		if (redir_prefix != NULL) {
+			size_t new_len = (leading_slash ? 1 : 0) + strlen(redir_prefix) + strlen(tail) + 1;
+			if (new_len <= MAXPATHLEN) {
+				char *redir_buf = zalloc(ZV_NAMEI);
+				if (redir_buf != NULL) {
+					snprintf(redir_buf, MAXPATHLEN, "%s%s%s",
+					    leading_slash ? "/" : "", redir_prefix, tail);
+					if (cnp->cn_flags & HASBUF) {
+						zfree(ZV_NAMEI, cnp->cn_pnbuf);
+					}
+					cnp->cn_pnbuf = redir_buf;
+					cnp->cn_pnlen = MAXPATHLEN;
+					cnp->cn_flags |= HASBUF;
+					ndp->ni_pathlen = (u_int)new_len;
+				}
+			}
+		}
+	}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
