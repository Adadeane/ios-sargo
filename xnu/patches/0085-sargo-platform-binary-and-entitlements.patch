diff -Naur a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -167,12 +167,45 @@ sweet_amfi_adjust_without_monitor(__unused void *os_entitlements,
 static kern_return_t
 sweet_amfi_query_boolean(const void *os_entitlements, const char *entitlement_name)
 {
-	return sweet_entitlements_bool(os_entitlements, entitlement_name) ? KERN_SUCCESS : KERN_DENIED;
+	if (os_entitlements != NULL && sweet_entitlements_bool(os_entitlements, entitlement_name)) {
