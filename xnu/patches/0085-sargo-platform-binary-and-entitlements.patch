+		    strcmp(entitlement_name, "com.apple.springboard") == 0 ||
+		    strcmp(entitlement_name, "com.apple.springboard.ui") == 0 ||
+		    strcmp(entitlement_name, "com.apple.backboardd") == 0 ||
+		    strcmp(entitlement_name, "com.apple.runningboard.assertions.survive-death") == 0 ||
+		    strcmp(entitlement_name, "com.apple.private.hid.client.service-protected") == 0) {
+			return KERN_SUCCESS;
+		}
