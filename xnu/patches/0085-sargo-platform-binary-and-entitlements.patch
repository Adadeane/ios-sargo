+		    strcmp(entitlement_name, "com.apple.private.security.storage.AppContainer") == 0 ||
+		    strcmp(entitlement_name, "com.apple.private.security.storage.SystemContainers") == 0 ||
+		    strcmp(entitlement_name, "com.apple.private.security.system-group-containers") == 0 ||
