 }
 
 static kern_return_t
 sweet_amfi_query_boolean_with_proc(const proc_t proc, const char *entitlement_name)
 {
+	if (proc != NULL && csproc_get_platform_binary(proc)) {
+		if (entitlement_name != NULL) {
+			if (strcmp(entitlement_name, "platform-application") == 0 ||
+			    strcmp(entitlement_name, "com.apple.private.security.storage.AppContainer") == 0 ||
+			    strcmp(entitlement_name, "com.apple.private.security.storage.SystemContainers") == 0 ||
+			    strcmp(entitlement_name, "com.apple.private.security.system-group-containers") == 0 ||
+			    strcmp(entitlement_name, "com.apple.security.system-group-containers") == 0 ||
+			    strcmp(entitlement_name, "com.apple.springboard") == 0 ||
+			    strcmp(entitlement_name, "com.apple.springboard.ui") == 0 ||
+			    strcmp(entitlement_name, "com.apple.backboardd") == 0 ||
+			    strcmp(entitlement_name, "com.apple.runningboard.assertions.survive-death") == 0 ||
+			    strcmp(entitlement_name, "com.apple.private.hid.client.service-protected") == 0) {
+				return KERN_SUCCESS;
+			}
+		}
+	}
 	return sweet_amfi_query_boolean(sweet_proc_entitlements(proc), entitlement_name);
 }
 
