# HakiOS U-Boot configuration fragment for Google Pixel 3a (sargo)
CONFIG_DEFAULT_DEVICE_TREE="qcom/sdm670-google-sargo"
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/google/sargo.env"
CONFIG_POSITION_INDEPENDENT=y
CONFIG_CMD_HAKIOS=y
CONFIG_CMD_BOOTEFI=y
CONFIG_USB_GADGET=y
CONFIG_DM_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_EFI_HAKIOS_USB_DEVICE=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_CMD_MMC=y
CONFIG_CMD_FAT=y
CONFIG_DOS_PARTITION=y
CONFIG_EFI_PARTITION=y
